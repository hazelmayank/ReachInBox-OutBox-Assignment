generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id               String            @id @default(cuid())
  googleId         String            @unique
  email            String            @unique
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaigns        Campaign[]
  senders          SenderAccount[]
  slackConnection  SlackConnection?
}

model SenderAccount {
  id                    String           @id @default(cuid())
  userId                String
  name                  String
  email                 String
  smtpHost              String
  smtpPort              Int
  smtpSecure            Boolean          @default(false)
  smtpUser              String
  encryptedSmtpPassword String
  isDefault             Boolean          @default(false)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns             Campaign[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id             String           @id @default(cuid())
  userId         String
  senderId       String
  subject        String
  bodyHtml       String
  startTime      DateTime
  delayMs        Int
  hourlyLimit    Int
  recipientCount Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         SenderAccount    @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails         ScheduledEmail[]

  @@index([userId, createdAt])
}

model ScheduledEmail {
  id             String      @id @default(cuid())
  campaignId     String
  recipient      String
  sequence       Int
  scheduledAt    DateTime
  status         EmailStatus @default(SCHEDULED)
  sentAt         DateTime?
  failedAt       DateTime?
  lastError      String?
  providerId     String?
  previewUrl     String?
  attemptCount   Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sequence])
  @@index([status, scheduledAt])
  @@index([campaignId])
  @@index([recipient])
}

model SlackConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  teamId               String
  teamName             String?
  botUserId            String?
  channelId            String
  channelName          String?
  encryptedAccessToken String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
