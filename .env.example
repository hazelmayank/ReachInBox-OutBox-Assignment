NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
# At least 32 characters. Used to encrypt SMTP and Slack secrets at rest.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
COOKIE_SECURE=false

# Create an OAuth web client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Create a Slack app with chat:write scope and OAuth redirect URL below.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/slack/callback
SLACK_SCOPES=chat:write,incoming-webhook
SLACK_DEFAULT_CHANNEL_ID=

# Ethereal credentials from https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ReachInbox Demo

WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=5000
QUEUE_PREFIX=reachinbox
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me
LOG_LEVEL=info
